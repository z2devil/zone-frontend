{
  "name": "zone-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "prepare": "husky install",
    "dev": "next dev",
    "dev-debug": "cross-env NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "build-debug": "next build --debug",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:skills": "node --test \".codex/skills/**/*.test.mjs\"",
    "check": "pnpm typecheck && pnpm test && pnpm test:skills && pnpm lint",
    "changeset": "changeset",
    "clean": "rimraf .next node_modules"
  },
  "dependencies": {
