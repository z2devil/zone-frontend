    "lucide-react": "^0.469.0",
    "mermaid": "^11.16.0",
    "motion": "^12.23.12",
    "next": "15.5.27",
    "postcss": "8.5.29",
    "prismjs": "^1.29.0",
    "react": "19.2.8",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "react-use": "^17.5.0",
    "remark-gfm": "^4.0.1",
